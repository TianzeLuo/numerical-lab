# 统一行尾（本项目在 WSL 与 Windows 间共享，务必固定为 LF）
* text=auto eol=lf

# 二进制产物不得被行尾/编码转换破坏
*.nlf      binary
*.nlf.gz   binary
*.png      binary
*.gif      binary
*.pdf      binary
*.woff2    binary
*.ttf      binary

# 生成物：让 GitHub 语言统计更诚实
viz/chapters/**/manifest.gen.ts  linguist-generated=true
viz/shared/colorscales.json      linguist-generated=true
docs/PROGRESS.md                 linguist-generated=true
chapters/**/asserts_report.md    linguist-generated=true
